.env.example

# Copy this file to .env and fill in your credentials. Do NOT commit the real .env file.
# Example placeholders for Zerodha / KiteConnect
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_ACCESS_TOKEN=your_access_token_here

# Optional runtime configuration
SYMBOL=AAPL
INITIAL_CAPITAL=10000
SMA_SHORT=20
SMA_LONG=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
BACKTEST_START=2020-01-01
BACKTEST_END=2023-12-31
